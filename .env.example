# Database Configuration
# For local development with Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paperdoc"

# For production (Supabase, Neon, Railway, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Authentication Secrets
# Generate these with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-64-character-hex-secret-for-jwt-signing-replace-this"
SHARE_LINK_SECRET="your-64-character-hex-secret-for-share-tokens-replace-this"

# Optional: Application Configuration
NODE_ENV="development"
# NODE_ENV="production"

# Optional: Email Configuration (for future expiry notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@paperdoc.app"

# Optional: Storage Configuration (for future file uploads)
# AWS_S3_BUCKET="paperdoc-documents"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="ap-south-1"

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Optional: Payment Configuration (Razorpay for Indian market)
# RAZORPAY_KEY_ID="rzp_test_xxxxx"
# RAZORPAY_KEY_SECRET="your-secret-key"
# NEXT_PUBLIC_RAZORPAY_KEY="rzp_test_xxxxx"
