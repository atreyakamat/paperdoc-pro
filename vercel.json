{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "AUTH_SECRET": {
      "description": "Secret for JWT signing (generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\")",
      "required": true
    },
    "SHARE_LINK_SECRET": {
      "description": "Secret for share tokens (generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\")",
      "required": true
    },
    "NODE_ENV": {
      "description": "Environment mode",
      "value": "production"
    }
  },
  "build": {
    "env": {
      "DATABASE_URL": "@DATABASE_URL",
      "AUTH_SECRET": "@AUTH_SECRET",
      "SHARE_LINK_SECRET": "@SHARE_LINK_SECRET",
      "NODE_ENV": "production"
    }
  }
}
